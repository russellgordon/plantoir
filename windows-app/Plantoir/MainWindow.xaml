<Window
    x:Class="Plantoir.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Plantoir.Views"
    xmlns:models="using:Plantoir.Core.Models"
    Title="Plantoir">

    <Grid x:Name="Root">
        <!-- No window-level accelerators since #488: every key is on a MENU
             item (MainWindow.Menus.cs), so the menu shows it and one key
             means one thing. Measured on this PC: an item's key fires with its
             menu closed and focus anywhere in the window outside the preview's
             page (documentation/12-windows-app.md, "Menus, the Section menu's
             functions and #475 on Windows"). -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Menu bar: File, Course, Section, View and Help (#488, the mac's
             #457). Their items are built in MainWindow.Menus.cs from one table,
             so each carries its contract item (subjectMenus), its key and its
             AutomationId in one place. It also carries the window's READINESS
             for UI Automation (#473): AutomationProperties.ItemStatus is
             "copying", "ready" or "failed" from the moment the window exists,
             set in code-behind. The menu bar because it is always there and
             has an automation peer; a panel has none, and the banner is absent
             while it is closed. -->
        <MenuBar Grid.Row="0" x:Name="AppMenuBar"
                 AutomationProperties.AutomationId="appMenuBar">
            <MenuBarItem x:Name="FileMenu" Title="File" />
            <MenuBarItem x:Name="CourseMenu" Title="Course" />
            <MenuBarItem x:Name="SectionMenu" Title="Section" />
            <MenuBarItem x:Name="ViewMenu" Title="View" />
            <MenuBarItem x:Name="HelpMenu" Title="Help" />
        </MenuBar>

        <!-- The picker replaces the ENTIRE content area, sidebar included. -->
        <!-- A restored working folder that a cloud service keeps in sync. A row
             of its own under the menu bar, ABOVE the content: the content row
             is the star-sized one, so it absorbs the notice's height and the
             path bar can never be pushed off screen (the mac's inline-banner
             regression), and nothing is drawn over the section toolbar (which
             an overlay would have covered). Dismissable; never a dialog. -->
        <StackPanel Grid.Row="1">
        <InfoBar x:Name="SyncNotice" Margin="12,8,12,0"
                 IsOpen="False" Severity="Informational" IsClosable="True"
                 Closed="SyncNotice_Closed"
                 AutomationProperties.AutomationId="syncedFolderNotice">
            <InfoBar.ActionButton>
                <Button x:Name="SyncNoticeDetailsButton" Click="SyncNoticeDetails_Click"
                        AutomationProperties.AutomationId="syncedFolderNoticeDetails" />
            </InfoBar.ActionButton>
            <StackPanel Spacing="8" Margin="0,4,0,8">
                <StackPanel x:Name="SyncNoticeDetails" Visibility="Collapsed" Spacing="6" />
                <Button x:Name="SyncNoticeDismissButton" Click="SyncNoticeDismiss_Click"
                        HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="syncedFolderNoticeDismiss" />
            </StackPanel>
        </InfoBar>
        <!-- #473: the app is copying what it needs into this folder, in the
             background, after the window has appeared. Opened only if the
             copy is still running a second after the window was shown (the
             ordinary launch compares every file in about half a second, and
             a banner for that would flash); an error, and kept, if the copy
             could not finish. Not closable: it says why Preview and Deploy
             are greyed, and it goes by itself when they come back. Same row
             as the synced-folder notice, under it, so the content row still
             absorbs the height. Words: ToolchainReadiness. -->
        <InfoBar x:Name="GettingReadyNotice" Margin="12,8,12,0"
                 IsOpen="False" Severity="Informational" IsClosable="False"
                 AutomationProperties.AutomationId="gettingReadyNotice" />
        </StackPanel>

        <views:WorkspacePickerView x:Name="Picker" Grid.Row="2" Visibility="Collapsed" />

        <Grid x:Name="SplitView" Grid.Row="2" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <views:SidebarPane x:Name="Sidebar" Grid.Column="0" />
            <Border Grid.Column="0" Width="1" HorizontalAlignment="Right"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <ContentPresenter x:Name="DetailHost" Grid.Column="1" />
        </Grid>

        <!-- Working-folder path bar, under the detail content — where the
             file manager puts its own. -->
        <Grid x:Name="PathBar" Grid.Row="3" Visibility="Collapsed"
              Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
              Padding="8,4" ColumnSpacing="8" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Working folder:" FontWeight="SemiBold" VerticalAlignment="Center" />
            <BreadcrumbBar x:Name="FolderCrumbs" Grid.Column="1" VerticalAlignment="Center"
                           ItemClicked="FolderCrumbs_ItemClicked" AutomationProperties.AutomationId="windowPathBar">
                <BreadcrumbBar.ItemTemplate>
                    <DataTemplate>
                        <!-- BreadcrumbBar generates its own BreadcrumbBarItem
                             container per entry — this template supplies only
                             that container's CONTENT, never another
                             BreadcrumbBarItem (nesting one broke rendering
                             entirely: every crumb fell back to the bound
                             object's ToString()). Tooltip, context menu and
                             double-click attach to this root panel instead. -->
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    ToolTipService.ToolTip="{Binding Path}"
                                    DoubleTapped="Crumb_DoubleTapped">
                            <StackPanel.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Show in File Explorer" Click="CrumbShowInExplorer_Click" />
                                    <MenuFlyoutItem Text="Open Folder" Click="CrumbOpenFolder_Click" />
                                </MenuFlyout>
                            </StackPanel.ContextFlyout>
                            <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </BreadcrumbBar.ItemTemplate>
            </BreadcrumbBar>
        </Grid>
    </Grid>
</Window>
