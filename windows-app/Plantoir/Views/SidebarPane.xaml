<UserControl
    x:Class="Plantoir.Views.SidebarPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Plantoir.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TreeView x:Name="Tree" SelectionMode="Single"
                      ItemInvoked="Tree_ItemInvoked"
                      AutomationProperties.AutomationId="coursesSidebar">
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="views:SidebarRow">
                        <!-- Menu and the clock badge both need Mode=OneWay: rows are
                             RECONCILED, not recreated (row 172's own comment), so
                             Menu is reassigned and ScheduledDeploy re-read on every
                             Refresh() pass without this row's container ever being
                             torn down. x:Bind defaults to OneTime — without OneWay
                             here (and SidebarRow implementing INotifyPropertyChanged
                             for both), a deploy scheduled after this row was first
                             shown would be invisible until the app restarted. -->
                        <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded}"
                                      ContextFlyout="{x:Bind Menu, Mode=OneWay}"
                                      AutomationProperties.AutomationId="{x:Bind AutomationId}">
                            <StackPanel Orientation="Horizontal" Spacing="8" ToolTipService.ToolTip="{x:Bind Tooltip}">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" />
                                <TextBlock Text="{x:Bind Title}" />
                                <!-- A clock, only on a section with a deploy waiting to fire.
                                     Its own tooltip says when: the row's tooltip is about the
                                     section, and "at 6:30 tomorrow" belongs to the clock. -->
                                <FontIcon Glyph="{x:Bind BadgeGlyph}" FontSize="12" Opacity="0.75"
                                          Visibility="{x:Bind BadgeVisibility, Mode=OneWay}"
                                          ToolTipService.ToolTip="{x:Bind BadgeTooltip, Mode=OneWay}" />
                            </StackPanel>
                        </TreeViewItem>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <!-- Shown only when a non-blank filter hides every course. -->
            <StackPanel x:Name="NoMatches" Visibility="Collapsed" Spacing="6"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="noFilterMatchesMessage">
                <FontIcon Glyph="&#xE721;" FontSize="28" Opacity="0.5" HorizontalAlignment="Center" />
                <TextBlock Text="No Matches" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="NoMatchesDetail" Opacity="0.7" TextWrapping="Wrap"
                           TextAlignment="Center" MaxWidth="180" />
            </StackPanel>
        </Grid>

        <!-- Footer: +, −, Filter — the list's own commands live at its foot. -->
        <Grid Grid.Row="1" Height="40" Padding="8,0" ColumnSpacing="2"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="AddButton" Grid.Column="0" MinWidth="30" MinHeight="28" Padding="0"
                    Background="Transparent" BorderThickness="0" Click="Add_Click"
                    ToolTipService.ToolTip="Add a course or club"
                    AutomationProperties.AutomationId="addCourseButton">
                <FontIcon Glyph="&#xE710;" FontSize="14" />
            </Button>
            <Button x:Name="RemoveButton" Grid.Column="1" MinWidth="30" MinHeight="28" Padding="0"
                    Background="Transparent" BorderThickness="0" Click="Remove_Click" IsEnabled="False"
                    ToolTipService.ToolTip="Remove the selected course or section"
                    AutomationProperties.AutomationId="removeSelectedButton">
                <FontIcon Glyph="&#xE738;" FontSize="14" />
            </Button>
            <TextBox x:Name="FilterBox" Grid.Column="2" PlaceholderText="Filter" Margin="6,0,0,0"
                     VerticalAlignment="Center" TextChanged="Filter_TextChanged"
                     AutomationProperties.AutomationId="courseFilterField" />
        </Grid>
    </Grid>
</UserControl>
