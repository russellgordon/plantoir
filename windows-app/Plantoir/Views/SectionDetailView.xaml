<UserControl
    x:Class="Plantoir.Views.SectionDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Accelerators live at view scope, not on the toolbar buttons — a
         focused web view swallows key events before button shortcuts see
         them; scoped accelerators always work. -->
    <Grid KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="R" Invoked="ReloadAccelerator" />
            <KeyboardAccelerator Modifiers="Menu" Key="Left" Invoked="BackAccelerator" />
            <KeyboardAccelerator Modifiers="Menu" Key="Right" Invoked="ForwardAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The toolbar is STABLE: every item always present, disabled when
             inapplicable; Preview/Stop is ONE button that changes face. -->
        <Grid Grid.Row="0" Padding="8,4" ColumnSpacing="4"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0" IsEnabled="False" Click="Back_Click"
                    Background="Transparent" BorderThickness="0" MinWidth="34" MinHeight="30"
                    ToolTipService.ToolTip="Go back a page"
                    AutomationProperties.AutomationId="previewBackButton">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <Button x:Name="ForwardButton" Grid.Column="1" IsEnabled="False" Click="Forward_Click"
                    Background="Transparent" BorderThickness="0" MinWidth="34" MinHeight="30"
                    ToolTipService.ToolTip="Go forward a page"
                    AutomationProperties.AutomationId="previewForwardButton">
                <FontIcon Glyph="&#xE72A;" FontSize="14" />
            </Button>
            <Button x:Name="ReloadButton" Grid.Column="2" IsEnabled="False" Click="Reload_Click"
                    Background="Transparent" BorderThickness="0" MinWidth="34" MinHeight="30"
                    ToolTipService.ToolTip="Reload this page"
                    AutomationProperties.AutomationId="previewReloadButton">
                <FontIcon Glyph="&#xE72C;" FontSize="14" />
            </Button>
            <TextBlock Grid.Column="3" x:Name="SectionTitle" VerticalAlignment="Center"
                       FontWeight="SemiBold" Margin="10,0,0,0" />

            <Button x:Name="ObsidianButton" Grid.Column="5" Click="Obsidian_Click"
                    Background="Transparent" BorderThickness="0" MinWidth="34" MinHeight="30"
                    ToolTipService.ToolTip="Edit this section's pages in Obsidian"
                    AutomationProperties.AutomationId="openInObsidianButton">
                <FontIcon Glyph="&#xE70F;" FontSize="14" />
            </Button>
            <Button x:Name="PreviewButton" Grid.Column="6" Click="PreviewOrStop_Click"
                    MinWidth="34" MinHeight="30"
                    ToolTipService.ToolTip="Preview this section's website"
                    AutomationProperties.AutomationId="previewButton">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="PreviewIcon" Glyph="&#xE768;" FontSize="14" />
                    <TextBlock x:Name="PreviewLabel" Text="Preview" />
                </StackPanel>
            </Button>
            <!-- "Deploy", NOT "Publish" — reversing row 103, which dropped
                 the word as jargon. It has to come back, because "publish"
                 now names something else entirely: a page carries
                 `publish: true` when students can see it in the built site.
                 One word cannot mean both "this page is visible" and "send
                 the whole site to the web" without the assistant and the
                 teacher talking past each other. Deploy is the rarer word,
                 so it takes the rarer act. -->
            <Button x:Name="DeployButton" Grid.Column="7" Click="Deploy_Click"
                    MinWidth="34" MinHeight="30"
                    ToolTipService.ToolTip="Deploy this section's website"
                    AutomationProperties.AutomationId="deployButton">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE724;" FontSize="14" />
                    <TextBlock Text="Deploy" />
                </StackPanel>
            </Button>
            <Button x:Name="BrowserButton" Grid.Column="8" IsEnabled="False" Click="OpenInBrowser_Click"
                    Background="Transparent" BorderThickness="0" MinWidth="34" MinHeight="30"
                    ToolTipService.ToolTip="Open this preview in your web browser"
                    AutomationProperties.AutomationId="openInBrowserButton">
                <FontIcon Glyph="&#xE774;" FontSize="14" />
            </Button>
        </Grid>

        <!-- How last night's scheduled publish turned out. An InfoBar rather
             than a dialog on purpose: a dialog can only be acknowledged, and
             this has to be DISMISSABLE — the record now stands until the
             teacher clears it or a run that gets through replaces it
             (contracts/shared-rules.json, scheduledPublishStopped.clearedBy).
             A dialog also cannot be shown at all when another one is already
             up, which is how the first version of this could lose the only
             record of an overnight failure. Never covers the toolbar; the
             preview keeps the row below. -->
        <InfoBar x:Name="ScheduledPublishNotice" Grid.Row="1" Margin="12,8,12,0"
                 IsOpen="False" IsClosable="True" Closed="ScheduledPublishNotice_Closed"
                 AutomationProperties.AutomationId="scheduledPublishNotice">
            <InfoBar.ActionButton>
                <Button Content="Dismiss" Click="ScheduledPublishNoticeDismiss_Click"
                        AutomationProperties.AutomationId="scheduledPublishNoticeDismiss" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Base layer stays MOUNTED under the full-bleed web view — the
             console never inherits a departing web view's geometry. -->
        <Grid Grid.Row="2">
            <Grid x:Name="BaseLayer">
                <StackPanel x:Name="NoPreviewState" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="8" MaxWidth="460">
                    <FontIcon Glyph="&#xE774;" FontSize="40" Opacity="0.5" HorizontalAlignment="Center" />
                    <TextBlock Text="No Preview Running" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <!-- Text set in code: it follows the course's publishing
                         choice (Netlify or a folder), per row 103. -->
                    <TextBlock x:Name="NoPreviewDetail" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
                <!-- The progress view fills the whole detail area so its console
                     grows to fill and its input row pins to the bottom, level
                     with the sidebar's Filter field. -->
                <views:TaskProgressView x:Name="Progress" xmlns:views="using:Plantoir.Views"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </Grid>
            <WebView2 x:Name="Preview" Visibility="Collapsed"
                      AutomationProperties.AutomationId="previewWebView" />
        </Grid>
    </Grid>
</UserControl>
