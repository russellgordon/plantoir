<UserControl
    x:Class="Plantoir.Views.CourseSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="16,10" ColumnSpacing="8"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="HeaderCode" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="HeaderName" Opacity="0.7" FontSize="12" />
            </StackPanel>
            <Button x:Name="ObsidianButton" Grid.Column="1" Background="Transparent" BorderThickness="0"
                    MinWidth="34" MinHeight="30" Click="Obsidian_Click"
                    ToolTipService.ToolTip="Edit this course's pages in Obsidian"
                    AutomationProperties.AutomationId="openCourseInObsidianButton">
                <FontIcon Glyph="&#xE70F;" FontSize="14" />
            </Button>
        </Grid>

        <ScrollViewer x:Name="FormScroll" Grid.Row="1" Padding="16,0,16,16">
            <StackPanel x:Name="Form" Spacing="8" MaxWidth="720" HorizontalAlignment="Left" />
        </ScrollViewer>

        <Grid Grid.Row="2" Padding="12" ColumnSpacing="10"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Revert, not Cancel: a settings form is not a dialog — the
                 values simply go back to the last save. -->
            <Button x:Name="RevertButton" Content="Revert" IsEnabled="False" Click="Revert_Click"
                    AutomationProperties.AutomationId="revertButton" />
            <TextBlock x:Name="SaveStatus" Grid.Column="2" VerticalAlignment="Center" FontSize="13"
                       AutomationProperties.AutomationId="savedConfirmation" />
            <Button x:Name="SaveButton" Grid.Column="3" Content="Save" IsEnabled="False" Click="Save_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.AutomationId="saveButton">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Modifiers="Control" Key="S" />
                </Button.KeyboardAccelerators>
            </Button>
        </Grid>
    </Grid>
</UserControl>
