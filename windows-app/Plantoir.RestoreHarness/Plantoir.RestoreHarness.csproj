<Project Sdk="Microsoft.NET.Sdk">

  <!-- #911: the second process the kill tests (RestoreKillTests) run the real
       one-section restore in and kill at each SwapPoint. In NO solution: the
       unit test project builds it through a ProjectReference that takes none
       of its output, and nothing the app ships references it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plantoir.Core\Plantoir.Core.csproj" />
  </ItemGroup>

</Project>
