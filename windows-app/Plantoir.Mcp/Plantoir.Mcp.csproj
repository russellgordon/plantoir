<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>plantoir-mcp</AssemblyName>
    <RootNamespace>Plantoir.Mcp</RootNamespace>

    <!-- Teachers install nothing: the published binary carries its runtime.
         Both platforms are listed because one implementation serves both —
         the launchers differ (deploy.ps1 / deploy.sh), the logic does not. -->
    <RuntimeIdentifiers>win-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plantoir.Core\Plantoir.Core.csproj" />
  </ItemGroup>

  <!-- So a test can pin what "today" is, the way Plantoir.Core already lets
       one. Nothing here is on the tool surface: the MCP SDK serves methods
       carrying [McpServerTool] and nothing else. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Plantoir.Tests" />
  </ItemGroup>

</Project>
