<UserControl
    x:Class="Plantoir.Views.TaskProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The header is pinned and fixed; the output pane is a bounded, clipped
         scroll area — no amount of output can push the header out of reach. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Padding="12" Spacing="10">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="15" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="OutcomeIcon" FontSize="14" Visibility="Collapsed" />
                    <TextBlock x:Name="PhaseText" Opacity="0.7"
                               AutomationProperties.AutomationId="taskPhaseLabel" />
                </StackPanel>
            </Grid>
            <!-- One row per configured destination, shown only for a
                 multi-destination deploy (more than one leg) — so a teacher
                 can see which destinations have finished and which are
                 still to come, rather than a bar that looks stuck between
                 legs. -->
            <StackPanel x:Name="DestinationChecklist" Visibility="Collapsed" Spacing="2"
                        AutomationProperties.AutomationId="destinationChecklist" />
            <ProgressBar x:Name="Bar" IsIndeterminate="True" />
            <TextBlock x:Name="MilestoneText" Opacity="0.7"
                       AutomationProperties.AutomationId="taskMilestoneLabel" />
            <TextBlock x:Name="OutcomeDetail" Visibility="Collapsed" TextWrapping="Wrap" Opacity="0.8"
                       AutomationProperties.AutomationId="failureExplanation" />
            <StackPanel x:Name="LiveLink" Visibility="Collapsed" Spacing="4"
                        AutomationProperties.AutomationId="publishedSiteLink">
                <TextBlock Text="Your website is live." />
                <HyperlinkButton x:Name="LiveLinkButton" Padding="0" />
            </StackPanel>
            <!-- Every SUCCEEDED destination's own link, once a
                 multi-destination run has finished — occupies the exact
                 slot LiveLink/FolderResult would for a single destination,
                 rather than being appended after the whole panel, so it
                 never floats below "Show details" (see WINDOWS-HANDOFF.md
                 entries 306, 309). -->
            <StackPanel x:Name="DestinationLinks" Visibility="Collapsed" Spacing="10"
                        AutomationProperties.AutomationId="destinationLinks" />
            <!-- Folder publishing's completion: the folder, not a live link
                 (rows 101-102) — with the quiet note that pages opened
                 straight from the folder will not look right. -->
            <StackPanel x:Name="FolderResult" Visibility="Collapsed" Spacing="6"
                        AutomationProperties.AutomationId="publishedFolderResult">
                <TextBlock Text="Your website was deployed to a folder — upload it to your web host whenever you're ready." />
                <Button x:Name="FolderResultButton" Content="Show in File Explorer"
                        AutomationProperties.AutomationId="publishedFolderButton"
                        Click="FolderResult_Click" />
                <TextBlock Opacity="0.7" FontSize="12" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="publishedFolderRenderNote"
                           Text="Opened straight from the folder, the pages won't look right — the site only displays properly once it's on your web host." />
            </StackPanel>
            <StackPanel x:Name="AwaitingNotice" Orientation="Horizontal" Spacing="6" Visibility="Collapsed"
                        AutomationProperties.AutomationId="awaitingInputNotice">
                <FontIcon Glyph="&#xE897;" FontSize="14" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                <TextBlock Text="Waiting for your answer…" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
            </StackPanel>
            <TextBlock x:Name="LaunchProblemText" Visibility="Collapsed" TextWrapping="Wrap"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            <Grid x:Name="RunningActionsRow" Visibility="Collapsed" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="WhyTakingLongButton" Background="Transparent" BorderThickness="0"
                        Padding="0" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="whyTakingLongButton">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE9CE;" FontSize="12" Opacity="0.7" />
                        <TextBlock Text="Why might this take a while?" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel MaxWidth="380" Spacing="12" Padding="4">
                                <TextBlock Text="Why might this take a while?" FontWeight="SemiBold" FontSize="14" />
                                <StackPanel Spacing="2">
                                    <TextBlock Text="First-time setup" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="Getting everything ready for the first time takes a couple of minutes to set up your website builder. Future previews and deploys will be much faster (usually just a few seconds)."
                                               TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="First-time publishing" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="Uploading your entire website for the first time takes a bit longer. Future publishes only upload the pages you’ve changed."
                                               TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Photos and attachments" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="Courses with many images, documents, or media files take extra time to prepare and upload."
                                               TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
                                </StackPanel>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Internet connection" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Text="When publishing online, upload speed depends on your current internet connection."
                                               TextWrapping="Wrap" Opacity="0.8" FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Grid.Column="1" x:Name="TaskCancelButton" Content="Cancel"
                        Click="TaskCancel_Click" AutomationProperties.AutomationId="taskCancelButton" />
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <Button Grid.Row="2" x:Name="DisclosureButton" Background="Transparent" BorderThickness="0"
                Padding="12,6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Click="Disclosure_Click" AutomationProperties.AutomationId="taskDetailsDisclosure">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <FontIcon x:Name="DisclosureChevron" Glyph="&#xE76C;" FontSize="10" Opacity="0.7" />
                <TextBlock x:Name="DisclosureLabel" Text="Show details" Opacity="0.7" FontSize="13" />
            </StackPanel>
        </Button>

        <!-- Console fills the remaining height (row 3 is *, clipped, scrolls
             internally); the wizard bounds it with its own ScrollViewer. -->
        <Grid Grid.Row="3" x:Name="ConsolePane" Visibility="Collapsed"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="ConsoleScroll" Padding="12" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <TextBlock x:Name="ConsoleText" FontFamily="Consolas" FontSize="12" IsTextSelectionEnabled="True"
                           AutomationProperties.AutomationId="consoleText" />
            </ScrollViewer>
            <Grid Grid.Row="1" x:Name="ConsoleInputRow" Padding="8" ColumnSpacing="8" Visibility="Collapsed"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ConsoleInput" PlaceholderText="If you're asked a question, type your answer here…"
                         KeyDown="ConsoleInput_KeyDown" AutomationProperties.AutomationId="consoleInputField" />
                <Button Grid.Column="1" Content="Send" Click="ConsoleSend_Click" />
                <Button Grid.Column="2" Content="Stop" Click="ConsoleStop_Click" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
