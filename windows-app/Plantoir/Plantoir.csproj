<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Plantoir</RootNamespace>
    <AssemblyName>Plantoir</AssemblyName>
    <ApplicationTitle>Plantoir</ApplicationTitle>
    <!-- The product version: the single source the About panel reads, the
         release zip is named after, and the git tag must match (v1.0.0).
         Keep in lockstep with the mac app's marketing version. -->
    <Version>1.7.2</Version>
    <Company>Russell Gordon</Company>
    <Product>Plantoir</Product>
    <Copyright>Copyright 2026 Russell Gordon</Copyright>
    <!-- A clean "1.0.0" in the file's Properties dialog, not "1.0.0+<hash>". -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- SelfContained must be EXPLICIT: with a RuntimeIdentifier set,
         `dotnet publish` has defaulted to framework-DEPENDENT since .NET 6,
         and WindowsAppSDKSelfContained covers only the WinAppSDK half. The
         gap shipped in 1.0.x and put an "install .NET" dialog in front of a
         workshop of teachers - dev machines all carry runtimes, so no local
         test ever saw it. -->
    <SelfContained>true</SelfContained>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <DefineConstants>DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- The exe's own icon: Explorer, taskbar, Alt-Tab. Derived from the mac
         Icon Composer art (see AboutDialog for the in-app copy). -->
    <ApplicationIcon>Assets\Plantoir.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runtime copies: the window icon (AppWindow.SetIcon wants a file) and
         the About panel's image. -->
    <Content Include="Assets\Plantoir.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\PlantoirIcon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plantoir.Core\Plantoir.Core.csproj" />
  </ItemGroup>

  <!-- The full toolchain recipe travels with the app and is mirrored into
       each working folder's .toolchain (the launchers hash it to name the
       image). The pruned paths mirror Get-ToolchainHash's prune list. -->
  <ItemGroup>
    <Content Include="..\..\Dockerfile" Link="Toolchain\Dockerfile" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\setup.sh" Link="Toolchain\setup.sh" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\preview.sh" Link="Toolchain\preview.sh" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\deploy.sh" Link="Toolchain\deploy.sh" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\setup.ps1" Link="Toolchain\setup.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\preview.ps1" Link="Toolchain\preview.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\deploy.ps1" Link="Toolchain\deploy.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\setup.bat" Link="Toolchain\setup.bat" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\preview.bat" Link="Toolchain\preview.bat" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\deploy.bat" Link="Toolchain\deploy.bat" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\patches\**" Link="Toolchain\patches\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- __pycache__ excluded: running the shared Python tests writes .pyc files there, and packing them gave PRI249 warnings (bundle 1). -->
    <Content Include="..\..\scripts\**" Exclude="..\..\scripts\**\__pycache__\**" Link="Toolchain\scripts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\support\**" Link="Toolchain\support\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\contracts\**" Link="Toolchain\contracts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The native llama engine runs on the host for GPU-accelerated local assistant inference -->
  <ItemGroup Condition="Exists('..\Vendor\llama\llama-server.exe')">
    <Content Include="..\Vendor\llama\**" Link="llama\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Obsidian's add-ons for diagrams and graphs (#581, the mac's #495):
       TikZJax 0.5.2 and Functionplot 1.2.1, seven files, 12.9 MB, from
       Vendor\fetch-obsidian-addons.ps1, carried as obsidian-addons\<id>\<file>
       beside Plantoir.exe (Content, so publish carries them too, as llama\).
       Never downloaded on the teacher's yes: contracts/shared-rules.json ->
       obsidianAddOnsForFigures.carried says why. -->
  <ItemGroup>
    <Content Include="..\Vendor\obsidian-addons\**" Link="obsidian-addons\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- REFUSES a build without them, or with a copy that is not the
       contract's: the folder missing, a file too many or too few, or any
       file whose SHA-256 is not the pin for THAT add-on's file of that name
       (each (id, name, sha256) triple is looked for in the contract, not just
       the hash). Like CheckNativeRuntimeManifest, so a release cannot ship
       without them by accident. The count is the contract's total; a test
       (ObsidianFigureAddOnsTests) holds the two equal. -->
  <PropertyGroup>
    <_PlantoirAddOnFileCount>7</_PlantoirAddOnFileCount>
  </PropertyGroup>
  <Target Name="CheckObsidianAddOns" BeforeTargets="BeforeBuild;Publish">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\..\Vendor\obsidian-addons')"
           Text="windows-app\Vendor\obsidian-addons is missing: run windows-app\Vendor\fetch-obsidian-addons.ps1 once in this clone (it reads the pins from contracts\shared-rules.json) and build again." />
    <ItemGroup>
      <_PlantoirAddOnFile Include="$(MSBuildProjectDirectory)\..\Vendor\obsidian-addons\**" />
    </ItemGroup>
    <GetFileHash Files="@(_PlantoirAddOnFile)" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_PlantoirAddOnHashed" />
    </GetFileHash>
    <PropertyGroup>
      <_PlantoirContract>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\..\contracts\shared-rules.json'))</_PlantoirContract>
    </PropertyGroup>
    <ItemGroup>
      <_PlantoirAddOnChecked Include="@(_PlantoirAddOnHashed)">
        <AddOnId>$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('%(FullPath)'))))</AddOnId>
        <Pinned>$([System.Text.RegularExpressions.Regex]::IsMatch($(_PlantoirContract), '&quot;id&quot;\s*:\s*&quot;$([System.Text.RegularExpressions.Regex]::Escape($([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('%(FullPath)'))))))&quot;,[^\]]*?\{(?=[^{}]*&quot;name&quot;\s*:\s*&quot;$([System.Text.RegularExpressions.Regex]::Escape('%(Filename)%(Extension)'))&quot;)(?=[^{}]*&quot;sha256&quot;\s*:\s*&quot;$([System.String]::Copy('%(FileHash)').ToLowerInvariant())&quot;)[^{}]*\}'))</Pinned>
      </_PlantoirAddOnChecked>
    </ItemGroup>
    <Error Condition="'@(_PlantoirAddOnFile->Count())' != '$(_PlantoirAddOnFileCount)'"
           Text="windows-app\Vendor\obsidian-addons holds @(_PlantoirAddOnFile->Count()) files, not the $(_PlantoirAddOnFileCount) the contract pins: run windows-app\Vendor\fetch-obsidian-addons.ps1 again and build again." />
    <Error Condition="'%(_PlantoirAddOnChecked.Pinned)' != 'True'"
           Text="windows-app\Vendor\obsidian-addons\%(_PlantoirAddOnChecked.AddOnId)\%(_PlantoirAddOnChecked.Filename)%(_PlantoirAddOnChecked.Extension) is not the file contracts\shared-rules.json pins: run windows-app\Vendor\fetch-obsidian-addons.ps1 again and build again. (If the fetch says the files are in place, the contract's obsidianAddOnsForFigures.addOns layout may have changed - an add-on's id must come before its files - and this check needs updating.)" />
  </Target>

  <!-- Ensure the MCP server binary is always freshly published beside the app -->
  <Target Name="PublishMcpBesideApp" AfterTargets="Build">
    <MSBuild Projects="..\Plantoir.Mcp\Plantoir.Mcp.csproj" Targets="Publish" Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);PublishDir=$(TargetDir)" />
  </Target>

  <!-- The native toolchain runtime (node, python, patched Quartz, wrangler)
       from Vendor\fetch-runtime.ps1. Mirrored with robocopy rather than
       Content items: it holds ~24,000 files (node_modules), and that many
       MSBuild items slows every build. Robocopy exit codes below 8 mean
       success, hence the exit-code laundering. -->
  <!-- A runtime fetched before 2026-10-15 has no runtime\vendor (Paged.js,
       Latin Modern, function-plot, the TikZ engine: #496, #503), and one
       fetched before 2026-10-22 has no Pyodide in it (#568); robocopy would
       ship either without them, silently: every printable page, graph,
       diagram and runnable Python block would then fall back on a teacher's
       machine. So a runtime whose
       manifest lacks any of the vendor keys stops the build and says what to
       run (the batch 5 plan review's M5). No runtime at all is still allowed:
       the targets below are skipped, as before. -->
  <Target Name="CheckNativeRuntimeManifest" Condition="Exists('..\Vendor\runtime\manifest.json')">
    <PropertyGroup>
      <_PlantoirRuntimeManifest>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\..\Vendor\runtime\manifest.json'))</_PlantoirRuntimeManifest>
    </PropertyGroup>
    <Error Condition="!$(_PlantoirRuntimeManifest.Contains('&quot;pagedjs&quot;')) Or !$(_PlantoirRuntimeManifest.Contains('&quot;latinModern&quot;')) Or !$(_PlantoirRuntimeManifest.Contains('&quot;functionPlot&quot;')) Or !$(_PlantoirRuntimeManifest.Contains('&quot;nodeTikzjax&quot;')) Or !$(_PlantoirRuntimeManifest.Contains('&quot;pyodide&quot;'))"
           Text="windows-app\Vendor\runtime predates the page features (Paged.js, Latin Modern, function-plot, the TikZ engine, Pyodide): its manifest.json lacks their keys. Re-run windows-app\Vendor\fetch-runtime.ps1 (it fetches only runtime\vendor) and build again." />
  </Target>
  <Target Name="CopyNativeRuntime" AfterTargets="Build" DependsOnTargets="CheckNativeRuntimeManifest" Condition="Exists('..\Vendor\runtime\manifest.json')">
    <Exec Command="robocopy &quot;$(MSBuildProjectDirectory)\..\Vendor\runtime&quot; &quot;$(TargetDir)runtime&quot; /MIR /NFL /NDL /NJH /NJS /NP &amp; if %25errorlevel%25 lss 8 exit /b 0" />
  </Target>
  <Target Name="PublishNativeRuntime" AfterTargets="Publish" DependsOnTargets="CheckNativeRuntimeManifest" Condition="Exists('..\Vendor\runtime\manifest.json')">
    <Exec Command="robocopy &quot;$(MSBuildProjectDirectory)\..\Vendor\runtime&quot; &quot;$(PublishDir)runtime&quot; /MIR /NFL /NDL /NJH /NJS /NP &amp; if %25errorlevel%25 lss 8 exit /b 0" />
  </Target>
</Project>
