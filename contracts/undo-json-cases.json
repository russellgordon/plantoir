{
  "note": "Moved out of shared-rules.json -> undo (#899 W6), where both platforms first read them, because some of these rows must hold an object with two keys that differ only by case (X1 and x1, Ab and aB): Windows PowerShell 5.1's ConvertFrom-Json, which windows-app/test_launcher_rules.ps1 and test_stop_preview.ps1 use to read shared-rules.json, cannot read a file that holds one. This file is read by Windows' UndoOpKindsContractTests, the mac's UndoContractReplay (UndoJournalContractTests) and scripts/test_make_undo_traces.py, and by no PowerShell; every other contract file must stay readable by ConvertFrom-Json (Windows' ContractFilesWindowsPowerShellReadsTests runs it on each, and scripts/test_make_undo_traces.py checks its rule on this Mac). Everything else about these rows is as editJSONCasesHow says; the rules they pin stay in shared-rules.json -> undo and file-formats.json -> undoJournal.opKinds.editJSON.",
  "editJSONCasesHow": "An editJSON move on the bytes of a file (file-formats.json -> undoJournal.opKinds.editJSON): file is the file's text, op the op (its before and after any JSON, a missing one meaning no such member), direction undo (towards before) or redo (towards after), and result the file's exact text afterwards, or null when the move is refused (as changed since). Both platforms must produce these bytes exactly: only the member's own bytes change, and a new value is spelled compactly with keys sorted.",
  "editJSONCases": [
    {
      "name": "only the member's value changes: spacing, 1.50, an escaped slash and a key written twice elsewhere stay",
      "file": "{\n    \"zeta\": 1.50,\n    \"alpha\": \"a\\/b \\u00e9\",\n    \"dup\": 1,\n    \"dup\": 2,\n    \"school_year\": \"2026-2027\"\n}\n",
      "op": {
        "keyPath": [
          "school_year"
        ],
        "before": "2025-2026",
        "after": "2026-2027",
        "kind": "editJSON",
        "path": "course_config.json"
      },
      "direction": "undo",
      "result": "{\n    \"zeta\": 1.50,\n    \"alpha\": \"a\\/b \\u00e9\",\n    \"dup\": 1,\n    \"dup\": 2,\n    \"school_year\": \"2025-2026\"\n}\n"
    },
    {
      "name": "a member added goes after the last one, spaced as that one is",
      "file": "{\n  \"a\" : 1,\n  \"b\" : 0.10\n}\n",
      "op": {
        "keyPath": [
          "c"
        ],
        "after": "x",
        "kind": "editJSON",
        "path": "course_config.json"
      },
      "direction": "redo",
      "result": "{\n  \"a\" : 1,\n  \"b\" : 0.10,\n  \"c\" : \"x\"\n}\n"
    },
    {
      "name": "the first member taken out takes the comma after it",
      "file": "{\n  \"a\" : 1,\n  \"b\" : 0.10\n}\n",
      "op": {
        "keyPath": [
          "a"
        ],
        "after": 1,
        "kind": "editJSON",
        "path": "course_config.json"
      },
      "direction": "undo",
      "result": "{\n  \"b\" : 0.10\n}\n"
    },
    {
      "name": "the last member taken out takes the comma before it",
      "file": "{\n  \"a\" : 1,\n  \"b\" : 0.10\n}\n",
      "op": {
        "keyPath": [
          "b"
        ],
        "after": 0.1,
        "kind": "editJSON",
        "path": "course_config.json"
      },
      "direction": "undo",
      "result": "{\n  \"a\" : 1\n}\n"
    },
    {
      "name": "a member added to an empty object, its value spelled compactly with keys sorted",
      "file": "{}",
      "op": {
        "keyPath": [
          "k"
        ],
        "after": {
          "z": true,
          "a": null
        },
        "kind": "editJSON",
        "path": "course_config.json"
      },
      "direction": "redo",
      "result": "{\"k\": {\"a\":null,\"z\":true}}"
    },
    {
      "name": "a member inside objects inside objects",
      "file": "{\"s\": {\"2\": {\"label\": \"P2\"}}}",
      "op": {
        "keyPath": [
          "s",
          "2",
          "label"
        ],
        "before": "P1",
        "after": "P2",
        "kind": "editJSON",
        "path": "course_config.json"
      },
      "direction": "undo",
      "result": "{\"s\": {\"2\": {\"label\": \"P1\"}}}"
    },
    {
