<Window
    x:Class="Plantoir.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Plantoir.Views"
    xmlns:models="using:Plantoir.Core.Models"
    Title="Plantoir">

    <Grid x:Name="Root" KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="OpenWorkingFolderAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="NewWindowAccelerator" />
            <KeyboardAccelerator Modifiers="Control,Shift" Key="R" Invoked="ReloadCoursesAccelerator" />
            <!-- Global Preview shortcuts, mirroring mac's ⌘[/⌘]/⌘R: WinUI
                 resolves a key combo declared at more than one scope by
                 preferring the one nearest the focused element, so these
                 fire everywhere EXCEPT while focus is inside a
                 SectionDetailView's own Grid — there its identical,
                 more-local accelerators win instead and act on that view
                 directly. Together the two scopes give the same "always
                 works" behaviour mac gets from a single menu-bar shortcut. -->
            <KeyboardAccelerator Modifiers="Control" Key="R" Invoked="PreviewReloadAccelerator" />
            <KeyboardAccelerator Modifiers="Menu" Key="Left" Invoked="PreviewBackAccelerator" />
            <KeyboardAccelerator Modifiers="Menu" Key="Right" Invoked="PreviewForwardAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Menu bar: File and Preview commands act on this window. -->
        <MenuBar Grid.Row="0" x:Name="AppMenuBar">
            <MenuBarItem Title="File">
                <MenuFlyoutItem x:Name="OpenWorkingFolderItem" Text="Open Working Folder…" Click="OpenWorkingFolder_Click" KeyboardAcceleratorTextOverride="Ctrl+O" />
                <MenuFlyoutItem x:Name="NewWindowItem" Text="New Window" Click="NewWindow_Click" KeyboardAcceleratorTextOverride="Ctrl+N" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="RestoreFromArchiveItem" Text="Restore from Archive…" Click="RestoreFromArchive_Click" IsEnabled="False" />
                <MenuFlyoutItem x:Name="ReloadCoursesItem" Text="Reload Courses" Click="ReloadCourses_Click" KeyboardAcceleratorTextOverride="Ctrl+Shift+R" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="SettingsItem" Text="Settings…" Click="Settings_Click" KeyboardAcceleratorTextOverride="Ctrl+," />
            </MenuBarItem>
            <!-- Acts on whichever section's preview is currently shown in
                 DetailHost, matching mac's Preview menu; the accelerator
                 text shown here is backed by real, globally-scoped
                 KeyboardAccelerators on Root above. -->
            <MenuBarItem Title="Preview">
                <MenuFlyoutItem x:Name="PreviewBackItem" Text="Back" Click="PreviewBack_Click"
                                 IsEnabled="False" KeyboardAcceleratorTextOverride="Alt+Left" />
                <MenuFlyoutItem x:Name="PreviewForwardItem" Text="Forward" Click="PreviewForward_Click"
                                 IsEnabled="False" KeyboardAcceleratorTextOverride="Alt+Right" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:Name="PreviewReloadItem" Text="Reload Page" Click="PreviewReload_Click"
                                 IsEnabled="False" KeyboardAcceleratorTextOverride="Ctrl+R" />
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="Report a Problem…" Click="ReportProblem_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="About Plantoir" Click="About_Click" />
            </MenuBarItem>
        </MenuBar>

        <!-- The picker replaces the ENTIRE content area, sidebar included. -->
        <views:WorkspacePickerView x:Name="Picker" Grid.Row="1" Visibility="Collapsed" />

        <Grid x:Name="SplitView" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" MinWidth="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <views:SidebarPane x:Name="Sidebar" Grid.Column="0" />
            <Border Grid.Column="0" Width="1" HorizontalAlignment="Right"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            <ContentPresenter x:Name="DetailHost" Grid.Column="1" />
        </Grid>

        <!-- Working-folder path bar, under the detail content — where the
             file manager puts its own. -->
        <Grid x:Name="PathBar" Grid.Row="2" Visibility="Collapsed"
              Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
              Padding="8,4" ColumnSpacing="8" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Working folder:" FontWeight="SemiBold" VerticalAlignment="Center" />
            <BreadcrumbBar x:Name="FolderCrumbs" Grid.Column="1" VerticalAlignment="Center"
                           ItemClicked="FolderCrumbs_ItemClicked" AutomationProperties.AutomationId="windowPathBar">
                <BreadcrumbBar.ItemTemplate>
                    <DataTemplate>
                        <!-- BreadcrumbBar generates its own BreadcrumbBarItem
                             container per entry — this template supplies only
                             that container's CONTENT, never another
                             BreadcrumbBarItem (nesting one broke rendering
                             entirely: every crumb fell back to the bound
                             object's ToString()). Tooltip, context menu and
                             double-click attach to this root panel instead. -->
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    ToolTipService.ToolTip="{Binding Path}"
                                    DoubleTapped="Crumb_DoubleTapped">
                            <StackPanel.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Show in File Explorer" Click="CrumbShowInExplorer_Click" />
                                    <MenuFlyoutItem Text="Open Folder" Click="CrumbOpenFolder_Click" />
                                </MenuFlyout>
                            </StackPanel.ContextFlyout>
                            <Image Source="{Binding Icon}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </BreadcrumbBar.ItemTemplate>
            </BreadcrumbBar>
        </Grid>
    </Grid>
</Window>
